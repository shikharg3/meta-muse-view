[Unit]
Description=Meta dashboard web (TanStack Start SSR, Nitro node-server)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
WorkingDirectory=/opt/meta-dashboard
EnvironmentFile=/opt/meta-dashboard/.env
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8787
ExecStart=/usr/local/bin/bun /opt/meta-dashboard/.output/server/index.mjs
Restart=always
RestartSec=3
# Nitro drains connections on SIGTERM; cap the wait so redeploys/restarts are fast.
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
