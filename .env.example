# Meta app + system user credentials.
# These can be left blank here and entered/managed from the Settings page in the app
# (stored encrypted in Postgres). They are only read from env as a bootstrap fallback.
META_APP_ID=
META_APP_SECRET=
META_SYSTEM_USER_TOKEN=
META_BUSINESS_ID=
META_API_VERSION=v25.0
# comma-separated act_ ids to sync (e.g. act_123,act_456)
META_AD_ACCOUNT_IDS=

# 32-byte hex key (64 chars). Encrypts the app secret + system user token at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=

# TESTING ONLY: set BOTH to replace the email/password login with a single shared HTTP Basic
# Auth credential. Leave both blank (production) to use the normal email/password login.
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# Emails auto-approved as admins on first sign-up (comma-separated). Everyone else signs up "pending".
AUTH_BOOTSTRAP_ADMINS=

# Telegram alert delivery (optional; both must be set or `sendTelegram` refuses and logs).
# Alerts are exception-driven only — spend collapse, low prepaid funds, unassigned spend.
#
# The chat id is NOT the invite link. A `https://t.me/+…` link cannot be used here: the Bot API
# needs the numeric id, and a bot cannot join a private channel by link. To get it:
#   1. Add the bot to the channel as an ADMIN with "Post messages" (a human has to do this).
#   2. curl -s "https://api.telegram.org/bot<TOKEN>/getUpdates"
#   3. Read `.result[].my_chat_member.chat.id` — a channel id looks like -1004386932732.
# Verify end to end with the "Send test message" button on /alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# Postgres connection. In local dev this points at the PRODUCTION database via the SSH tunnel
# (ssh -N -L 127.0.0.1:5432:127.0.0.1:5432 <droplet>). There is no local copy — every query you run
# locally hits production.
DATABASE_URL=postgres://meta:PASSWORD@127.0.0.1:5432/meta

# Isolated database for `bun test` (redirected via test-setup.ts). Never the real data.
#
# ONE PER DEVELOPER. The DB-backed tests truncate tables, so two people pointing at the same test
# database corrupt each other's runs and produce failures that do not reproduce. Create your own:
#   ssh <droplet> "sudo -u postgres createdb -O meta meta_test_<yourname>"
#   DATABASE_URL='postgres://meta:PASSWORD@127.0.0.1:5432/meta_test_<yourname>' bunx drizzle-kit push
TEST_DATABASE_URL=postgres://meta:PASSWORD@127.0.0.1:5432/meta_test_<yourname>
